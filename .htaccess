<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block access to hidden files and directories except .well-known (for AutoSSL)
    RewriteRule ^\.(?!well-known).* - [F,L,NC]

    # 2. Block direct HTTP access to core Laravel code, storage, tests, and configuration
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|blueprint)(\/.*)?$ - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js)$ - [F,L,NC]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 5. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 6. Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Runtime upload and execution limits for mod_php environments
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 32M
    php_value memory_limit 256M
    php_value max_file_uploads 50
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 32M
    php_value memory_limit 256M
    php_value max_file_uploads 50
</IfModule>

